          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl-7" value="valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#55778B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;fontColor=#47657A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fl-recheck" target="fl-commit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl-8" value="after commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#55778B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;fontColor=#47657A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fl-commit" target="fl-job">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#55778B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;fontColor=#47657A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fl-job" target="fl-done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl-ineligible" value="Already PAID or insufficient balance&#xa;409 / 422; no payment created" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;convertToSvg=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#173B55;fillColor=#FCE7E4;strokeColor=#BC625A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="350" y="430" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fl-mail-fail" value="OTP delivery fails&#xa;503; payment marked FAILED" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;convertToSvg=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#173B55;fillColor=#FCE7E4;strokeColor=#BC625A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="970" y="430" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fl-otp-fail" value="Invalid / expired OTP&#xa;422; no debit" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;convertToSvg=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#173B55;fillColor=#FCE7E4;strokeColor=#BC625A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1280" y="825" width="280" height="85" as="geometry" />
        </mxCell>
        <mxCell id="fl-finance-fail" value="Already PAID / insufficient balance&#xa;409 / 422; no debit" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;convertToSvg=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#173B55;fillColor=#FCE7E4;strokeColor=#BC625A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="945" y="825" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="fl-check-fail" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#55778B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;fontColor=#47657A;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fl-check" target="fl-ineligible">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl-email-fail" value="SMTP failure" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#55778B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;fontColor=#47657A;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fl-email" target="fl-mail-fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl-otp-fail-edge" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#55778B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;fontColor=#47657A;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fl-lock" target="fl-otp-fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl-finance-fail-edge" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#55778B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=12;fontColor=#47657A;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fl-recheck" target="fl-finance-fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl-foot" value="Database errors before commit roll back. Receipt failure leaves SUCCESS and a pending job; Notification uses a stable messageId for retries." style="text;html=1;convertToSvg=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#617B8D;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="970" width="1510" height="40" as="geometry" />
