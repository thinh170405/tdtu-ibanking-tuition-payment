          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl-error" value="Invalid / expired OTP, insufficient balance or already-paid tuition: no debit. Technical failure before commit: rollback." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;convertToSvg=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#173B55;fillColor=#FCE7E4;strokeColor=#BC625A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="360" y="755" width="900" height="80" as="geometry" />
