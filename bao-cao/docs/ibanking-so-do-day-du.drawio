        </mxCell>
        <mxCell id="06-concurrency-subtitle" value="PostgreSQL SELECT FOR UPDATE serializes conflicting confirmations; both scenarios are tested on the live stack." style="text;html=1;convertToSvg=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#617B8D;strokeColor=none;fillColor=none;" vertex="1" parent="1">
