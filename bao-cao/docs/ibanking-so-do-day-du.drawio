    <mxGraphModel dx="1560" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1030" background="#FFFFFF" math="0" shadow="0">
