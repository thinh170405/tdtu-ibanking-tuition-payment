        <mxCell id="cc-t21-title" value="T21  |  SAME WALLET, TWO TUITION CHARGES" style="text;html=1;convertToSvg=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#173B55;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="65" y="145" width="1430" height="38" as="geometry" />
