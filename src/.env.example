# Sao chép thành src/.env trước khi chạy Docker Compose.
# Tạo khóa ngẫu nhiên riêng; không commit giá trị thật.
POSTGRES_PASSWORD=change-this-local-db-password
PGADMIN_EMAIL=admin@ibanking-demo.org
PGADMIN_PASSWORD=change-this-local-pgadmin-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
INTERNAL_API_KEY=replace-with-a-separate-random-internal-key

# Thay bằng hộp thư do nhóm kiểm soát khi kiểm thử email thật.
DEMO_EMAIL_1=demo1@example.com
DEMO_EMAIL_2=demo2@example.com

# SMTP thật; nếu không đặt, Docker Compose dùng Mailpit cho demo local.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=STARTTLS
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ibanking@example.com
