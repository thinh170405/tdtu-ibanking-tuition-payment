# Contract 1.0.0. Template only: the application must implement reading these variables.
# Copy into each application's development config. Replace placeholders before integration.
# Never expose JWT_SECRET or INTERNAL_API_KEY through a frontend build.
CONTRACT_VERSION=1.0.0

# Browser-facing frontend config, local integrated mode.
# A works independently by changing PAYMENT_API_BASE_URL to http://localhost:8089/api/v1
ACCOUNT_API_BASE_URL=http://localhost:8081/api/v1
PAYMENT_API_BASE_URL=http://localhost:8082/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# Backend application ports.
ACCOUNT_PORT=8081
PAYMENT_PORT=8082
NOTIFICATION_PORT=8083

# JWT: A and B can use independent local test keys, then the SAME key when integrated.
JWT_ALGORITHM=HS256
JWT_ISSUER=ibanking-demo
JWT_AUDIENCE=ibanking-api
JWT_TTL_SECONDS=3600
JWT_SECRET=<generate-a-random-secret-of-at-least-32-bytes>

# Payment -> Notification. B's independent mock: http://localhost:8090
# Inside Docker Compose: http://notification:8083
NOTIFICATION_BASE_URL=http://localhost:8083
INTERNAL_API_KEY=<generate-a-separate-random-internal-key>
NOTIFICATION_TIMEOUT_MS=5000
SUCCESS_EMAIL_RETRY_INTERVAL_SECONDS=30

# OTP lifetime is server-side. Do not expose a public endpoint to set/obtain OTPs.
OTP_TTL_SECONDS=300

# Replace with databases belonging to the respective service. Never share write ownership.
ACCOUNT_DATABASE_URL=<account-database-connection-string>
PAYMENT_DATABASE_URL=<payment-database-connection-string>

# Notification provider, configured by A; actual variable mapping depends on the mail library.
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURITY=STARTTLS
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=<sender-address>

# Seed/test recipient overrides: use inboxes controlled by the group, then log in again.
DEMO_EMAIL_1=<real-test-inbox-for-u1>
DEMO_EMAIL_2=<real-test-inbox-for-u2>
